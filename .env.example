# ─────────────────────────────────────────────────────────────────────────
# CryptoBrain — environment configuration
# Copy to .env and fill in what you want to enable. Everything is optional:
# the engine works 100% offline-capable with Binance public market data.
# ─────────────────────────────────────────────────────────────────────────

# ── Market data ──────────────────────────────────────────────────────────
# DEMO_MODE=1 runs fully offline on the committed BTC sample + deterministic
# synthetic series for every other symbol (no Binance access needed). Use it
# on machines without Binance reachability; set DEMO_MODE=0 for live data.
DEMO_MODE=0

# Single-symbol default used by the dashboard/input field.
# Aliases supported: BTC -> BTCUSDT, ETH -> ETHUSDT, GOLD/XAU -> XAUUSD.
SYMBOL=BTCUSDT
# Dashboard/CLI watchlist presets for the core desk: BTC, ETH, XAU/GOLD.
# XAUUSD uses Binance PAXGUSDT spot candles as a tokenized-gold proxy while
# signals remain labeled XAUUSD.
SYMBOLS=BTCUSDT,ETHUSDT,XAUUSD
TIMEFRAME=15m
BARS=500

# ── Signal engine ────────────────────────────────────────────────────────
MIN_CONFIDENCE=55          # raw plans below this are dropped from the output
DEFAULT_RISK_REWARD=2.0    # TP1 risk:reward target
MAX_RISK_PCT=1.0           # hard ceiling for risk per trade (% of account) — advice only

# Institutional desk filter (AI Trading Intelligence System)
INTELLIGENCE_MIN_CONFIDENCE=80
INTELLIGENCE_MIN_RR=2.0
ACCOUNT_BALANCE=0          # set to enable position-size estimates
RISK_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_WEEKLY_LOSS_PCT=6.0

# ── CryptoDada website (private membership) ──────────────────────────────
# The connector can run in three modes:
#   auto  -> probe for the site's hidden JSON API first, fall back to browser
#   api   -> only use hidden API endpoints (fastest)
#   browser -> Playwright login + scrape (needs `pip install playwright`)
CRYPTODADA_MODE=auto
CRYPTODADA_BASE_URL=https://YOUR-CRYPTODADA-SITE.example
CRYPTODADA_EMAIL=
CRYPTODADA_PASSWORD=
CRYPTODADA_2FA=             # TOTP secret if the site uses 2FA (optional)

# ── Discord (private group) ──────────────────────────────────────────────
# Recommended: a webhook YOUR BOT posts INTO (outbound alerts), or
# an authenticated session to READ channels (check Discord ToS first).
DISCORD_WEBHOOK_URL=
DISCORD_TOKEN=              # user/bot token for reading channels (optional)
DISCORD_CHANNEL_IDS=        # comma-separated channel ids to read
DISCORD_ANNOUNCE_WEBHOOK=   # webhook to push signals to (optional)

# ── LLM AI Brain narrative (optional) ────────────────────────────────────
# provider: auto | groq | openai | gemini | off
LLM_PROVIDER=off
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Paper-trading runner (simulation only; never sends exchange orders) ──
# Start it with: python main.py paper --watch
PAPER_POLL_SECONDS=30
PAPER_MAX_CANDLES_PER_CHECK=1000

# ── Notifiers ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Professional operating mode (roadmap decisions) ──────────────────────
# Progression ladder: student | researcher | simulator | micro | consistent | scale.
#   student/researcher : unproven setups are research-only (no approvals, no paper)
#   simulator+         : paper-trade unproven setups to build the 100/20 sample proof
#   micro              : graduate here ONLY when the graduation gate passes
#                        (`python main.py agent ask "am i ready for micro?"`)
# Each level sets its own risk caps (see config.py PROGRESSION_LEVELS).
# BLUEPRINT Step 1: start in simulator to accumulate the 100–200 paper trades.
PROGRESSION=simulator

# Desk-first: scans/dashboard surface the strict NO-TRADE-first desk decision
# as the headline; raw engine plans stay visible as research.
DESK_DEFAULT=true

# Primary setup family (decision A1): only these plans may become tradeable.
#   sweep_trend_continuation = Sweep Reversal Buy/Sell + Buy/Sell Pullback
#   all                      = no narrowing (radar mode)
PRIMARY_SETUP_FAMILY=sweep_trend_continuation

# Data-driven TP targets (decision A2): per-setup R from measured expectancy,
# clamped to this range. INTELLIGENCE_MIN_RR is the safety FLOOR (1.5).
TP_RR_MIN=1.5
TP_RR_MAX=4.0

# Risk & discipline gate (decisions B6/B7) — enforced at approval + paper runner.
ENFORCE_RISK_LIMITS=true
DRAWDOWN_REDUCE_PCT=5.0
DRAWDOWN_STOP_PCT=8.0
DRAWDOWN_REVIEW_PCT=10.0
TRADER_STATE_BLOCK=true

# Portfolio/correlation risk (decision B2): BTC+ETH are ONE crypto bucket.
CRYPTO_BUCKET_MAX_TRADES=2
MAX_CRYPTO_EXPOSURE_RISK_PCT=1.0
ETH_BTC_GATE=true

# Gold playbook (decision B8): London/NY windows + US-data no-entry windows.
# Session mode: warn | block | off
GOLD_SESSION_MODE=warn
GOLD_NEWS_BLOCK=true

# Setup-proven thresholds (decisions A6/B10): 100 backtest + 20 paper samples.
CALIBRATE_MIN_N=100
CALIBRATE_MIN_PAPER_N=20

# Information hierarchy (decision A5): tiers <= SOURCE_TIER_MAX_AUTO may
# contribute to a tradeable signal; tier 5 (private) is context only.
SOURCE_TIER_MAX_AUTO=2
